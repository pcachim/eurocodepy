# Glob-based (dev/dbase_versioning.md phase 6): a new JSON/CSV/XLSX file
# added under src/eurocodepy/data/ is picked up automatically, instead of
# needing a manual "include" line here -- the previous explicit list had
# already silently missed eurocode_data_portugal.json.
recursive-include src/eurocodepy/data *.json *.csv *.xlsx
